{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests", // Pin to SHAs instead of versions
    "docker:pinDigests",
    ":configMigration", // Update renovate config
    "abandonments:recommended",
  ],

  "dependencyDashboard": true,

  "timezone": "Europe/Berlin",
  "schedule": ["* 1-5 * * *"],

  "prConcurrentLimit": 20,
  "prHourlyLimit": 5,
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change",
    "Pending",
    "References",
  ],
  "separateMultipleMajor": true, // Separate PRs for multiple major versions to simplify version migration
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional", // Allow updating dependencies without a release timestamp
  "logLevelRemap": [
    { // Since this warning is expected behavior, this remaps the warning to info log level
      "matchMessage": "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      "newLogLevel": "info"
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
  },

  "packageRules": [
    {
      // Group GitHub Actions updates
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"], // Group minor and patch, leaving major seperate
    },
    {
      // Warn when updating Java version in GitHub Actions
      "matchFileNames": [".github/actions/*.yml"],
      "matchPackageNames": ["java-jdk"],
      "prBodyNotes": [
        "> [!WARNING]",
        "> **Keep CI and prod in sync.** The CI pipeline should remain as close to prod as possible. If you merge this pull request, please also update the Java version in `app/build.gradle.kts` accordingly:",
        "> ```kotlin",
        "> java {",
        ">     toolchain {",
        ">         languageVersion = JavaLanguageVersion.of(25)",
        ">     }",
        "> }",
        "> ```"
      ],
    }
  ],

  "labels": ["renovate"],
}
