{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
    ':configMigration',
    'abandonments:recommended',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  timezone: 'Europe/Berlin',
  schedule: [
    '* 1-5 * * *',
  ],
  prConcurrentLimit: 20,
  prHourlyLimit: 5,
  prBodyColumns: [
    'Package',
    'Type',
    'Update',
    'Change',
    'Pending',
    'References',
  ],
  separateMultipleMajor: true,
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  logLevelRemap: [
    {
      matchMessage: "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      newLogLevel: 'info',
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
  packageRules: [
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      matchFileNames: [
        '.github/actions/*.yml',
      ],
      matchPackageNames: [
        'java-jdk',
      ],
      prBodyNotes: [
        '> [!WARNING]',
        '> **Keep CI and prod in sync.** The CI pipeline should remain as close to prod as possible. If you merge this pull request, please also update the Java version in `app/build.gradle.kts` accordingly:',
        '> ```kotlin',
        '> java {',
        '>     toolchain {',
        '>         languageVersion = JavaLanguageVersion.of(25)',
        '>     }',
        '> }',
        '> ```',
      ],
    },
  ],
  labels: [
    'renovate',
  ],
}
